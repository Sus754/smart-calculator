{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Bluebell calculator",
      "type": "process",
      "command": "py",
      "args": ["-m", "http.server", "8080", "--bind", "127.0.0.1"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [{ "regexp": "^__BLUEBELL_NO_PROBLEM__$", "file": 0, "message": 0 }],
        "background": {
          "activeOnStart": true,
          "endsPattern": "^Serving HTTP on .* port 8080"
        }
      }
    }
  ]
}
